{
  "name": "pebble-media-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  "r2_buckets": [
    { "binding": "pebble_media", "bucket_name": "pebble-media" }
  ],

  /* Timeless app/site usage. This is the one table that grows without bound —
     one row per app per day per user — so it lives in D1 (5 GB) rather than
     the Supabase free project's 500 MB Postgres, which it would fill in about
     six weeks at 1,000 daily users. See schema.sql. */
  "d1_databases": [
    { "binding": "pebble_usage", "database_name": "pebble-usage",
      "database_id": "c7902822-6b69-46b4-a230-afcfedc5b564" }
  ],

  "vars": {
    "PEBBLE_ORIGIN": "http://tauri.localhost"
  }
}