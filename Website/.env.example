# Public Firebase web configuration (Firebase Console > Project settings).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Optional App Check reCAPTCHA v3 public site key.
# Required when deploying the supplied protected callable functions.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Supabase project URL and public publishable key, never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# All credentials below belong only in your server secret manager, NOT here:
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, OPENAI_API_KEY